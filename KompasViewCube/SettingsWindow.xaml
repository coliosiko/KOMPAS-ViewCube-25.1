<Window x:Class="KompasViewCube.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" Height="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center"/>
            <ComboBox x:Name="LanguageBox" Grid.Column="1" SelectedValuePath="Tag">
                <ComboBoxItem Tag="ru">Русский</ComboBoxItem><ComboBoxItem Tag="en">English</ComboBoxItem>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ScaleLabel" VerticalAlignment="Center"/>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
                <Slider x:Name="ScaleSlider" Minimum="50" Maximum="100" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="ScaleSlider_ValueChanged"/>
                <TextBlock x:Name="ScaleValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PositionLabel" VerticalAlignment="Center"/>
            <CheckBox x:Name="PositionBox" Grid.Column="1" VerticalAlignment="Center" Checked="PositionEdit_Changed" Unchecked="PositionEdit_Changed" Content="Переместить мышью"/>
        </Grid>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Width="92" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="SaveButton" Width="92" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
